# /etc/claudestruct/env  — environment file consumed by both
# claudestruct.service and claudestruct-worker.service.
#
# Permissions: chmod 0640 + own as root:claudestruct so the systemd
# unit reads it but other users on the box don't see your API key.
#   sudo chown root:claudestruct /etc/claudestruct/env
#   sudo chmod 0640 /etc/claudestruct/env

# --- Provider credentials -------------------------------------------

# Cloud Anthropic (default provider). Required unless you flip
# CLAUDESTRUCT_PROVIDER=openai below and run fully local.
ANTHROPIC_API_KEY=sk-ant-...

# Switch to local Ollama / vLLM / SGLang. Comment out for the
# Anthropic-default deployment.
# CLAUDESTRUCT_PROVIDER=openai
# CLAUDESTRUCT_BASE_URL=http://localhost:11434/v1
# CLAUDESTRUCT_MODEL_DEFAULT=qwen2.5-coder:32b

# --- Daemon binding -------------------------------------------------

# Bind only on localhost; the reverse proxy (Caddy) terminates TLS.
# If you skip the reverse proxy and expose directly via Tailscale
# Funnel or a private LAN, set CLAW_WEB_TOKEN below as well.
CLAUDESTRUCT_BIND=127.0.0.1
CLAUDESTRUCT_PORT=8787

# --- Database -------------------------------------------------------

# SQLite by default — fine up to ~10 users. For more, point at a
# Postgres URL.
CLAUDESTRUCT_DATABASE_URL=sqlite:////var/lib/claudestruct/server.db

# --- Optional features ---------------------------------------------

# Region tag for the W8.5 X-CS-Region response header.
# CLAUDESTRUCT_REGION=eu-west-1

# Spend cap (USD per UTC calendar month). Hard-aborts before the
# LLM call when exceeded; warns at 80%.
# CLAUDESTRUCT_MONTHLY_CAP_USD=200

# OpenTelemetry tracing (optional; install `claudestruct[otel]`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry error reporting (optional; install `claudestruct[sentry]`).
# CLAUDESTRUCT_SENTRY_DSN=https://...

# Local LLM response cache. `auto` = ON for openai-compat, OFF for
# Anthropic. Override `on`/`off` per deployment.
CLAUDESTRUCT_LLM_CACHE=auto

# Worker poll interval when the queue is empty. Lower = more
# responsive, higher = less DB traffic.
CLAUDESTRUCT_WORKER_POLL_INTERVAL=1.0
